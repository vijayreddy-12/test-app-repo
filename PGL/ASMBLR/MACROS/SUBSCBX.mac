********W************************************************************   00006901
         SPACE                                                          00007001
SRVCREQ  DS    X              DATSRVC REQUEST CODE                      00007101
SRVCACT  EQU   X'01'              ACTION REQUIRED                       00007211
SRVCCLO  EQU   X'02'              SEQUENTIAL CLOSE REQUIRED             00007302
SRVCBND  EQU   X'03'              BIND REQUIRED                         00007404
SRVCCLN  EQU   X'04'              FREE STORAGE                          00007505
SRVCRC   DS    X              DATSRVC RETURN CODE                       00007606
SRVCRC0  EQU   X'00'              CLEAN CALL                            00007706
