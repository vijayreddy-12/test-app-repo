END-IF                                                                          
IF AGE = 35, 36, 37, 38, 39                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = .78                
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = .73                
   LRATE = .88                                                                  
END-IF                                                                          
IF AGE = 40, 41, 42, 43, 44                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = .96                
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = .90                
   LRATE = 1.08                                                                 
END-IF                                                                          
IF AGE = 45, 46, 47, 48, 49                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 1.38               
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 1.29               
   LRATE = 1.55                                                                 
END-IF                                                                          
IF AGE = 50, 51, 52, 53, 54                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 2.25               
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 2.10               
   LRATE = 2.52                                                                 
