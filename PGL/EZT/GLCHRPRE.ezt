*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 10.52              
   LRATE = 12.62                                                                
END-IF                                                                          
IF AGE = 75, 76, 77, 78, 79                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 18.75              
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 17.53              
   LRATE = 21.04                                                                
END-IF                                                                          
IF AGE GQ 80                                                                    
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 34.50              
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 32.26              
   LRATE = 38.71                                                                
END-IF                                                                          
                                                                                
LIFECALC                                                                        
ACTPREM = LIFEVOL / 1000 * LRATE + .005                                         
*DO NOT OFFER ANY MORE DISCOUNT OF 15%.                                         
*LPREM = ACTPREM * .85 + .005                                                   
LPREM = ACTPREM                                                                 
*AD&D CALCULATION                                                               
IF AGE = 70                                                                     
   ADDPREM = 0                                                                  
ELSE                                                                            
   ADDPREM = ADDVOL / 1000 * .15 + .005                                         
END-IF                                                                          
*THE FOLLOWING ARE THE CALCULATIONS FOR THE QUARTERLY DEPENDENT RATE            
IF DEPLIFE = 'N'                                                                
   DEPRATE = 0                                                                  
   GO TO CALC                                                                   
END-IF                                                                          
*****CHANGE STARTS - HARSHA GANDHI - APRIL 8 2003                               
*****THE FOLLOWING PIECE OF CODE IS TO INCLUDE TWO NEW OPTIONS                  
*****FOR THE DEALER-OWNER PROGRAM.                                              
*****OPTION 1 IS NEW AND OPTION 2 IS THE SAME AS THE PREVIOUS ONE.              
IF DEPLIFE = '1'                                                                
   IF AGE LQ 29                                                                 
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 5.58          
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW      DEPRATE = 5.22          
      DEPRATE = 6.26                                                            
   END-IF                                                                       
   IF AGE = 30, 31, 32, 33, 34                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 6.18          
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW      DEPRATE = 5.78          
      DEPRATE = 6.93                                                            
   END-IF                                                                       
   IF AGE = 35, 36, 37, 38, 39                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 7.20          
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW      DEPRATE = 6.73          
      DEPRATE = 8.08                                                            
   END-IF                                                                       
   IF AGE = 40, 41, 42, 43, 44                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 9.18          
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW      DEPRATE = 8.58          
      DEPRATE = 10.30                                                           
   END-IF                                                                       
   IF AGE = 45, 46, 47, 48, 49                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 12.60         
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW      DEPRATE = 11.78         
      DEPRATE = 14.14                                                           
   END-IF                                                                       
   IF AGE = 50, 51, 52, 53, 54                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 18.18         
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW      DEPRATE = 17.00         
      DEPRATE = 20.40                                                           
   END-IF                                                                       
   IF AGE = 55, 56, 57, 58, 59                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 26.40         
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW      DEPRATE = 24.68         
      DEPRATE = 29.62                                                           
