IF AGE = 75, 76, 77, 78, 79                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 24.30              
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 22.72              
   LRATE = 27.26                                                                
END-IF                                                                          
IF AGE GQ 80                                                                    
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 42.75              
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 39.97              
   LRATE = 47.97                                                                
END-IF                                                                          
GO TO LIFECALC                                                                  
NONSMOKER                                                                       
*THE FOLLOWING ARE THE QUARTERLY LIFE RATES FOR NON-SMOKERS                     
IF AGE LQ 29                                                                    
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = .27                
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = .25                
   LRATE = .30                                                                  
END-IF                                                                          
IF AGE = 30, 31, 32, 33, 34                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = .33                
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = .31                
   LRATE = .37                                                                  
END-IF                                                                          
IF AGE = 35, 36, 37, 38, 39                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = .48                
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = .45                
   LRATE = .54                                                                  
END-IF                                                                          
IF AGE = 40, 41, 42, 43, 44                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = .60                
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = .56                
   LRATE = .67                                                                  
END-IF                                                                          
IF AGE = 45, 46, 47, 48, 49                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = .99                
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = .93                
   LRATE = 1.11                                                                 
END-IF                                                                          
IF AGE = 50, 51, 52, 53, 54                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 1.65               
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 1.54               
   LRATE = 1.85                                                                 
END-IF                                                                          
IF AGE = 55, 56, 57, 58, 59                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 2.25               
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 2.10               
   LRATE = 2.52                                                                 
END-IF                                                                          
IF AGE = 60, 61, 62, 63, 64                                                     
