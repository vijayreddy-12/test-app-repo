*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW      DEPRATE = 3.37          
      DEPRATE = 4.04                                                            
   END-IF                                                                       
   IF AGE = 40, 41, 42, 43, 44                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 4.59          
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW      DEPRATE = 4.29          
      DEPRATE = 5.15                                                            
   END-IF                                                                       
   IF AGE = 45, 46, 47, 48, 49                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 6.30          
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW      DEPRATE = 5.89          
      DEPRATE = 7.07                                                            
   END-IF                                                                       
   IF AGE = 50, 51, 52, 53, 54                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 9.09          
