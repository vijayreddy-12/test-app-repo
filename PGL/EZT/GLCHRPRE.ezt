PARM LINK(GLCHRPRE R)                                                           
LIST ON                                                                         
                                                                                
FILE FILEA                                                                      
DEALNO 2 5 N HEADING ('DEAL.', ' NO.') MASK 'Z9999'                             
ZONE 7 3 A                                                                      
CERT 7 6 A HEADING ('CERT', 'NO.')                                              
NAME 13 20 A                                                                    
EFF 33 8 N HEADING ('EFFECT', ' DATE')                                          
BIRTHDAY 41 8 N                                                                 
BDAYMO 41 4 N                                                                   
BDAY   41 2 N                                                                   
BMONTH 43 2 N                                                                   
BYEAR 45 4 N                                                                    
PROV 56 2 N                                                                     
LIFEVOL 58 6 N 0 HEADING (' LIFE', ' VOLUME')                                   
ADDVOL 64 6 N 0 HEADING (' AD&D', ' VOLUME')                                    
DEPLIFE 70 1 A                                                                  
SMOKER 71 1 A                                                                   
**                                                                              
FILE FILEC PRINTER                                                              
**                                                                              
*                                                                               
FILE REPTFILE                                                                   
*                                                                               
REP-TITLE    1 124  A                                                           
RH1            1 50  A                                                          
RH2          51  44  A                                                          
RH3          94  32  A                                                          
RH4          126 25  A                                                          
RH5          151 11  A                                                          
*                                                                               
DEALNO-O   1    5  A                                                            
FILL1-O    6    1  A                                                            
CERT-O     7    6  A                                                            
FILL2-O   13    1  A                                                            
NAME-O    14   20  A                                                            
FILL3-O   34    1  A                                                            
DOB-O     35    8  A                                                            
FILL4-O   43    1  A                                                            
LIFEVOL-O 44    6  A                                                            
FILL5-O   50    1  A                                                            
LPREM-O   51    7  N 2                                                          
FILL5A-O  58    1  A                                                            
ADDVOL-O  59    6  N                                                            
FILL6-O   65    1  A                                                            
ADDPREM-O 66    7  N 2                                                          
FILL7-O   73    1  A                                                            
DEPRATE-O 74    4  N 2                                                          
FILL8-O   78    1  A                                                            
TOTPREM-O 79    7  N 2                                                          
FILL9-O   86    1  A                                                            
ONTAX-O   87    5  N 2                                                          
FILL10-O  92    1  A                                                            
PQTAX-O   93    5  N 2                                                          
FILL11-O  98    1  A                                                            
AMD-O     99    7  N 2                                                          
FILL12-O  106   1  A                                                            
PROV-O    107   2  A                                                            
*                                                                               
*WORKING STORAGE BEGINS                                                         
*                                                                               
AGE     W 2 N                                                                   
LRATE   W 4 N 2                                                                 
WLRATE  W 4 N 2                                                                 
ACTPREM W 7 N 2                                                                 
LPREM   W 7 N 2 HEADING ('   LIFE', '  PREMIUM')                                
ADDPREM W 7 N 2 HEADING ('   AD&D', '  PREMIUM')                                
DEPRATE W 4 N 2 HEADING ('   DEPS', '   PREM')                                  
TOTPREM W 7 N 2 HEADING ('  TOTAL', '  PREMIUM')                                
TAX     W 5 N 2 HEADING (' SALES', ' TAX')                                      
AMD     W 7 N 2 HEADING ('   AMOUNT', '  DUE')                                  
TAXRATE W 5 N 2                                                                 
ONTAX   W 5 N 2 HEADING ('ONT', 'TAX')                                          
PQTAX   W 5 N 2 HEADING ('QUE', 'TAX')                                          
                                                                                
WS-HDR-CREATED W    1 A VALUE 'N'                                               
                                                                                
WS-CURR-DATE   W   8  A                                                         
  WS-CURR-DD  WS-CURR-DATE   2  N                                               
  WS-CURR-MM  WS-CURR-DATE  +3  2  N                                            
  WS-CURR-YY  WS-CURR-DATE  +6  2  N                                            
                                                                                
WS-Y2K-CURR-CCYY  W  4  N                                                       
   WS-Y2K-CURR-CC  WS-Y2K-CURR-CCYY   2  N                                      
   WS-Y2K-CURR-YY  WS-Y2K-CURR-CCYY  +2  2  N                                   
                                                                                
WS-Y2K-CURR-DDMM  W  4  N                                                       
   WS-Y2K-CURR-DD  WS-Y2K-CURR-DDMM   2  N                                      
   WS-Y2K-CURR-MM  WS-Y2K-CURR-DDMM  +2  2  N                                   
                                                                                
MTHFR    W  7 A                                                                 
   FRMTH  MTHFR  3 A                                                            
   FRYEAR MTHFR  +3 4 A                                                         
MTHTO    W  7 A                                                                 
   TOMTH  MTHTO  3 A                                                            
   TOYEAR MTHTO  +3 4 A                                                         
                                                                                
**                                                                              
JOB                                                                             
                                                                                
WS-CURR-DATE = SYSDATE                                                          
WS-Y2K-CURR-YY = WS-CURR-YY                                                     
WS-Y2K-CURR-MM = WS-CURR-MM                                                     
WS-Y2K-CURR-DD = WS-CURR-DD                                                     
                                                                                
IF WS-CURR-YY < 90                                                              
   WS-Y2K-CURR-CC = 20                                                          
ELSE                                                                            
   WS-Y2K-CURR-CC = 19                                                          
END-IF                                                                          
                                                                                
***************                                                                 
* BUILD THE FROM AND TO YEARS BASED ON SYSTEM DATE                              
***************                                                                 
FRYEAR = WS-Y2K-CURR-CCYY                                                       
TOYEAR = WS-Y2K-CURR-CCYY                                                       
                                                                                
IF WS-CURR-MM = 01, 02, 03                                                      
   FRMTH = 'JAN'                                                                
   TOMTH = 'MAR'                                                                
END-IF                                                                          
IF WS-CURR-MM = 04, 05, 06                                                      
   FRMTH = 'APR'                                                                
   TOMTH = 'JUN'                                                                
END-IF                                                                          
IF WS-CURR-MM = 07, 08, 09                                                      
   FRMTH = 'JUL'                                                                
   TOMTH = 'SEP'                                                                
END-IF                                                                          
IF WS-CURR-MM = 10, 11, 12                                                      
   FRMTH = 'OCT'                                                                
   TOMTH = 'DEC'                                                                
END-IF                                                                          
                                                                                
IF WS-HDR-CREATED = 'N'                                                         
   WS-HDR-CREATED = 'Y'                                                         
   MOVE 'DEALNO,CERT,NAME,DOB,LIFEVOL,LPREM,ADDVOL,ADDPREM,' TO RH1             
   MOVE 'DEPRATE,TOTPREM,ONTAX,PQTAX,AMD,'              TO RH2                  
   MOVE 'PROV                            ' TO RH3                               
   MOVE '                         ' TO RH4                                      
   MOVE '           '                             TO RH5                        
   PUT REPTFILE                                                                 
   MOVE ' ' TO RH1                                                              
   MOVE ' ' TO RH2                                                              
   MOVE ' ' TO RH3                                                              
   MOVE ' ' TO RH4                                                              
   MOVE ' ' TO RH5                                                              
END-IF                                                                          
**                                                                              
TAX = 0.00                                                                      
TAXRATE = 0.00                                                                  
ONTAX   = 0.00                                                                  
PQTAX   = 0.00                                                                  
**                                                                              
IF BMONTH = 01, 02, 03, 04, 05, 06, 07, 08, 09, 10, 11, 12                      
   IF WS-Y2K-CURR-MM > BMONTH                                                   
      AGE = WS-Y2K-CURR-CCYY - BYEAR                                            
   ELSE                                                                         
      IF WS-Y2K-CURR-MM = BMONTH                                                
         IF WS-Y2K-CURR-DD >= BDAY                                              
            AGE = WS-Y2K-CURR-CCYY - BYEAR                                      
         ELSE                                                                   
            AGE = (WS-Y2K-CURR-CCYY - 1) - BYEAR                                
         END-IF                                                                 
      ELSE                                                                      
         AGE = (WS-Y2K-CURR-CCYY - 1) - BYEAR                                   
      END-IF                                                                    
   END-IF                                                                       
ELSE                                                                            
   AGE = (WS-Y2K-CURR-CCYY - 1) - BYEAR                                         
END-IF                                                                          
                                                                                
IF SMOKER = 'N'                                                                 
   GO TO NONSMOKER                                                              
END-IF                                                                          
                                                                                
*THE FOLLOWING ARE THE QUARTERLY LIFE RATES FOR SMOKERS                         
IF AGE LQ 29                                                                    
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = .45                
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = .42                
   LRATE = .50                                                                  
END-IF                                                                          
IF AGE = 30, 31, 32, 33, 34                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = .51                
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = .48                
