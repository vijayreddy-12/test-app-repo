END-IF                                                                          
*****CHANGE ENDS   - HARSHA GANDHI - APRIL 8 2003                               
CALC                                                                            
TOTPREM = LPREM + ADDPREM + DEPRATE                                             
                                                                                
PERFORM GET-PROVTAX                                                             
TAX = (TOTPREM * TAXRATE) + 0.005                                               
AMD = TOTPREM + TAX                                                             
PERFORM TOTAL-TAX                                                               
PRINT PREMDUE                                                                   
PERFORM REPORT-IN-FILE                                                          
*                                                                               
GET-PROVTAX. PROC                                                               
   IF PROV = 01                                                                 
      TAXRATE  = 0.00                                                           
   ELSE                                                                         
   IF PROV = 02                                                                 
      TAXRATE  = 0.00                                                           
   ELSE                                                                         
   IF PROV = 03                                                                 
      TAXRATE  = 0.00                                                           
   ELSE                                                                         
   IF PROV = 04                                                                 
      TAXRATE  = 0.00                                                           
   ELSE                                                                         
   IF PROV = 05                                                                 
      TAXRATE  = 0.08                                                           
   ELSE                                                                         
   IF PROV = 06                                                                 
      TAXRATE  = 0.09                                                           
   ELSE                                                                         
   IF PROV = 07                                                                 
      TAXRATE  = 0.00                                                           
   ELSE                                                                         
   IF PROV = 08                                                                 
      TAXRATE  = 0.00                                                           
   ELSE                                                                         
   IF PROV = 09                                                                 
      TAXRATE  = 0.00                                                           
   ELSE                                                                         
