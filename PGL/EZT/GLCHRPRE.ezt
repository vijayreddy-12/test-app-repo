      TAXRATE  = 0.00                                                           
   ELSE                                                                         
   IF PROV = 12                                                                 
      TAXRATE  = 0.00                                                           
   ELSE                                                                         
   IF PROV = 13                                                                 
      TAXRATE  = 0.00                                                           
   ELSE                                                                         
   IF PROV = 14                                                                 
      TAXRATE  = 0.00                                                           
   ELSE                                                                         
      TAXRATE  = 0.00                                                           
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
END-PROC                                                                        
                                                                                
                                                                                
TOTAL-TAX. PROC                                                                 
   IF PROV = 05                                                                 
      ONTAX = TAX                                                               
   ELSE                                                                         
   IF PROV = 06                                                                 
      PQTAX = TAX                                                               
   END-IF                                                                       
   END-IF                                                                       
END-PROC                                                                        
                                                                                
**                                                                              
REPORT-IN-FILE. PROC                                                            
    MOVE        DEALNO      TO DEALNO-O                                         
    MOVE        ','         TO FILL1-O                                          
    MOVE        CERT        TO CERT-O                                           
    MOVE        ','         TO FILL2-O                                          
    MOVE        NAME        TO NAME-O                                           
    MOVE        ','         TO FILL3-O                                          
    MOVE        BIRTHDAY    TO DOB-O                                            
    MOVE        ','         TO FILL4-O                                          
    MOVE        LIFEVOL     TO LIFEVOL-O                                        
    MOVE        ','         TO FILL5-O                                          
    MOVE        LPREM       TO LPREM-O                                          
    MOVE        ','         TO FILL5A-O                                         
    MOVE        ADDVOL      TO ADDVOL-O                                         
    MOVE        ','         TO FILL6-O                                          
    MOVE        ADDPREM     TO ADDPREM-O                                        
    MOVE        ','         TO FILL7-O                                          
    MOVE        DEPRATE     TO DEPRATE-O                                        
    MOVE        ','         TO FILL8-O                                          
    MOVE        TOTPREM     TO TOTPREM-O                                        
    MOVE        ','         TO FILL9-O                                          
    MOVE        ONTAX       TO ONTAX-O                                          
    MOVE        ','         TO FILL10-O                                         
    MOVE        PQTAX       TO PQTAX-O                                          
    MOVE        ','         TO FILL11-O                                         
    MOVE        AMD         TO AMD-O                                            
    MOVE        ','         TO FILL12-O                                         
    MOVE        PROV        TO PROV-O                                           
    PUT REPTFILE                                                                
END-PROC                                                                        
**                                                                              
REPORT PREMDUE PAGESIZE 60 NOADJUST SKIP 1 TITLESKIP 2 +                        
                PRINTER FILEC                                                   
**                                                                              
SEQUENCE ZONE CERT                                                              
CONTROL FINAL NOPRINT ZONE NOPRINT RENUM                                        
TITLE 1 '                                     DAIMLERCHRYSLER CANADA +          
LTD. DEALER-OWNER GROUP LIFE PLAN'                                              
TITLE 3 '                                          QUARTERLY PREMIUM +          
DUE LISTING @ ' MTHFR ' TO ' MTHTO                                              
LINE COL 2 DEALNO COL 8 CERT COL 15 NAME COL 36 BIRTHDAY +                      
     COL 45 LIFEVOL COL 55 LPREM COL 67 ADDVOL COL 75 ADDPREM +                 
     COL 88 DEPRATE COL 95 TOTPREM COL 105 ONTAX COL 112 PQTAX +                
     COL 120 AMD                                                                
BEFORE-BREAK. PROC                                                              
IF LEVEL = 1                                                                    
   DISPLAY SKIP 1 POS 5 LIFEVOL POS 7 ADDVOL POS 9 DEPRATE +                    
   POS 11 ONTAX POS 13 AMD                                                      
   DISPLAY POS 6 LPREM POS 8 ADDPREM POS 10 TOTPREM POS 12 PQTAX                
END-IF                                                                          
IF LEVEL = 2                                                                    
   DISPLAY NEWPAGE COL 41 'DAIMLERCHRYSLER CANADA LTD. DEALER-OWNER +           
   GROUP LIFE PLAN'                                                             
   DISPLAY SKIP 1 COL 43 'QUARTERLY PREMIUM DUE LISTING @ ' MTHFR +             
   ' TO ' MTHTO                                                                 
   DISPLAY SKIP 2 COL 2 'DEAL.' COL 9 'CERT' +                                  
   COL 49 'LIFE' COL 61 'LIFE' COL 71 'AD&D' COL 81 'AD&D' +                    
   COL 92 'DEPS' COL 100 'TOTAL' COL 108 'ONT' COL 115 'QUE' +                  
   COL 125 'AMOUNT'                                                             
                                                                                
   DISPLAY COL 3 'NO.' COL 9 'NO.' COL 23 'NAME' +                              
   COL 36 'BIRTHDAY' COL 48 'VOLUME' COL 59 'PREMIUM' COL 70 'VOLUME' +         
   COL 79 'PREMIUM' COL 92 'PREM' COL 99 'PREMIUM' COL 108 'TAX' +              
   COL 115 'TAX' COL 126 'DUE'                                                  
   DISPLAY SKIP 1 POS 1 'FINAL' POS 2 'TOTALS' POS 5 LIFEVOL +                  
                  POS 7 ADDVOL POS 9 DEPRATE +                                  
                  POS 11 ONTAX POS 13 AMD                                       
   DISPLAY POS 6 LPREM POS 8 ADDPREM POS 10 TOTPREM POS 12 PQTAX                
END-IF                                                                          
END-PROC                                                                        
