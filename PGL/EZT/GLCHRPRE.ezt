IF AGE = 55, 56, 57, 58, 59                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 3.45               
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 3.23               
   LRATE = 3.87                                                                 
END-IF                                                                          
IF AGE = 60, 61, 62, 63, 64                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 5.25               
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 4.91               
   LRATE = 5.89                                                                 
END-IF                                                                          
IF AGE = 65, 66, 67, 68, 69                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 6.00               
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 5.61               
   LRATE = 6.73                                                                 
END-IF                                                                          
IF AGE = 70, 71, 72, 73, 74                                                     
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW   LRATE = 15.00              
*OLD RATES - NEW RATES EFFECTIVE 2008 LISTED BELOW   LRATE = 14.03              
   LRATE = 16.83                                                                
