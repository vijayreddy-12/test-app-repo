PARM LINK(GLCHRACT R)                                                           
LIST ON                                                                         
                                                                                
FILE FILEA                                                                      
CARD 1 1 N                                                                      
DEALNO 2 5 N HEADING ('DEAL.', ' NO.') MASK 'Z9999'                             
ZONE 7 3 A                                                                      
CERT 10 3 N                                                                     
CERTIF 7 6 A HEADING ('CERT.', 'NO.')                                           
NAME 13 19 A                                                                    
EFF 33 8 N HEADING(' EFF.', ' DATE')                                            
BDAYMO 41 4 N                                                                   
BDAY   41 2 N                                                                   
BMONTH 43 2 N                                                                   
BYEAR 45 4 N                                                                    
BIRTHDAY 41 8 N                                                                 
*BIRTHDAY 41 8 N MASK D                                                         
RED 49 1 N HEADING ('A')                                                        
PERCENT 50 1 N HEADING ('B')                                                    
PLAN 51 2 N                                                                     
NODEAL 54 1 N HEADING ('C')                                                     
NOLIVE 55 1 N HEADING ('D')                                                     
PROV 56 2 N                                                                     
LIFEVOL 58 6 N 0 HEADING (' LIFE', ' VOLUME')                                   
ADDVOL 64 6 N 0 HEADING (' AD&D', ' VOLUME')                                    
DEPLIFE 70 1 A                                                                  
SMOKER 71 1 A HEADING ('E')                                                     
LVT W 7 N 0                                                                     
LPT W 7 N 2                                                                     
AVT W 7 N 0                                                                     
APT W 7 N 2                                                                     
DPT W 4 N 2                                                                     
TPT W 7 N 2                                                                     
AGE W 2 N                                                                       
LRATE W 4 N 2                                                                   
WLRATE W 4 N 2                                                                  
LPREM W 7 N 2 HEADING ('   LIFE', '  PREM.')                                    
ADDPREM W 7 N 2 HEADING ('   AD&D', '  PREM.')                                  
DEPRATE W 4 N 2 HEADING ('   DEP.', '  PREM.')                                  
TOTPREM W 7 N 2 HEADING ('  TOTAL', '  PREM.')                                  
TAX W 5 N 2 HEADING (' SALES', ' TAX')                                          
AMD W 7 N 2 HEADING ('   AMOUNT', '  DUE')                                      
**                                                                              
FILE FILEC PRINTER                                                              
**                                                                              
WS-CURR-DATE   W   8  A                                                         
  WS-CURR-DD  WS-CURR-DATE   2  N                                               
  WS-CURR-MM  WS-CURR-DATE  +3  2  N                                            
  WS-CURR-YY  WS-CURR-DATE  +6  2  N                                            
                                                                                
WS-Y2K-CURR-CCYY  W  4  N                                                       
   WS-Y2K-CURR-CC  WS-Y2K-CURR-CCYY   2  N                                      
   WS-Y2K-CURR-YY  WS-Y2K-CURR-CCYY  +2  2  N                                   
                                                                                
WS-Y2K-CURR-DDMM  W  4  N                                                       
   WS-Y2K-CURR-DD  WS-Y2K-CURR-DDMM   2  N                                      
   WS-Y2K-CURR-MM  WS-Y2K-CURR-DDMM  +2  2  N                                   
                                                                                
JOB                                                                             
**                                                                              
WS-CURR-DATE = SYSDATE                                                          
DISPLAY 'WCD', WS-CURR-DATE                                                     
WS-Y2K-CURR-YY = WS-CURR-YY                                                     
WS-Y2K-CURR-MM = WS-CURR-MM                                                     
WS-Y2K-CURR-DD = WS-CURR-DD                                                     
IF WS-CURR-YY < 90                                                              
   WS-Y2K-CURR-CC = 20                                                          
ELSE                                                                            
   WS-Y2K-CURR-CC = 19                                                          
END-IF                                                                          
                                                                                
IF BMONTH = 01, 02, 03, 04, 05, 06, 07, 08, 09, 10, 11, 12                      
***Y2K AGE = 98 - BYEAR                                                         
*  AGE = WS-Y2K-CURR-CCYY - BYEAR                                               
IF WS-Y2K-CURR-MM > BMONTH                                                      
   AGE = WS-Y2K-CURR-CCYY - BYEAR                                               
ELSE                                                                            
   IF WS-Y2K-CURR-MM = BMONTH                                                   
      IF WS-Y2K-CURR-DD >= BDAY                                                 
         AGE = WS-Y2K-CURR-CCYY - BYEAR                                         
      ELSE                                                                      
         AGE = (WS-Y2K-CURR-CCYY - 1) - BYEAR                                   
      END-IF                                                                    
   ELSE                                                                         
      AGE = (WS-Y2K-CURR-CCYY - 1) - BYEAR                                      
   END-IF                                                                       
END-IF                                                                          
ELSE                                                                            
***Y2K AGE = 97 - BYEAR                                                         
AGE = (WS-Y2K-CURR-CCYY - 1) - BYEAR                                            
END-IF                                                                          
                                                                                
IF SMOKER = 'N'                                                                 
GO TO NONSMOKER                                                                 
END-IF                                                                          
*THE FOLLOWING ARE THE QUARTERLY LIFE RATES FOR SMOKERS                         
IF AGE LQ 29                                                                    
LRATE = .50                                                                     
END-IF                                                                          
IF AGE = 30, 31, 32, 33, 34                                                     
LRATE = .57                                                                     
END-IF                                                                          
IF AGE = 35, 36, 37, 38, 39                                                     
LRATE = .88                                                                     
END-IF                                                                          
IF AGE = 40, 41, 42, 43, 44                                                     
LRATE = 1.08                                                                    
END-IF                                                                          
IF AGE = 45, 46, 47, 48, 49                                                     
LRATE = 1.55                                                                    
END-IF                                                                          
IF AGE = 50, 51, 52, 53, 54                                                     
LRATE = 2.52                                                                    
END-IF                                                                          
IF AGE = 55, 56, 57, 58, 59                                                     
LRATE = 3.87                                                                    
END-IF                                                                          
IF AGE = 60, 61, 62, 63, 64                                                     
LRATE = 5.89                                                                    
END-IF                                                                          
IF AGE = 65, 66, 67, 68, 69                                                     
LRATE = 6.73                                                                    
END-IF                                                                          
IF AGE = 70, 71, 72, 73, 74                                                     
LRATE = 16.83                                                                   
END-IF                                                                          
IF AGE = 75, 76, 77, 78, 79                                                     
LRATE = 27.26                                                                   
END-IF                                                                          
IF AGE GQ 80                                                                    
LRATE = 47.97                                                                   
END-IF                                                                          
GO TO LIFECALC                                                                  
NONSMOKER                                                                       
*THE FOLLOWING ARE THE QUARTERLY LIFE RATES FOR NON-SMOKERS                     
IF AGE LQ 29                                                                    
LRATE = .30                                                                     
END-IF                                                                          
IF AGE = 30, 31, 32, 33, 34                                                     
LRATE = .37                                                                     
END-IF                                                                          
IF AGE = 35, 36, 37, 38, 39                                                     
LRATE = .54                                                                     
END-IF                                                                          
IF AGE = 40, 41, 42, 43, 44                                                     
LRATE = .67                                                                     
END-IF                                                                          
IF AGE = 45, 46, 47, 48, 49                                                     
LRATE = 1.11                                                                    
END-IF                                                                          
IF AGE = 50, 51, 52, 53, 54                                                     
LRATE = 1.85                                                                    
END-IF                                                                          
IF AGE = 55, 56, 57, 58, 59                                                     
LRATE = 2.52                                                                    
END-IF                                                                          
IF AGE = 60, 61, 62, 63, 64                                                     
LRATE = 4.54                                                                    
END-IF                                                                          
IF AGE = 65, 66, 67, 68, 69                                                     
LRATE = 6.06                                                                    
END-IF                                                                          
IF AGE = 70, 71, 72, 73, 74                                                     
LRATE = 12.62                                                                   
END-IF                                                                          
IF AGE = 75, 76, 77, 78, 79                                                     
LRATE = 21.04                                                                   
END-IF                                                                          
IF AGE GQ 80                                                                    
LRATE = 38.71                                                                   
END-IF                                                                          
LIFECALC                                                                        
WLRATE = LRATE * .85 + .005                                                     
LPREM = LIFEVOL / 1000 * WLRATE + .005                                          
*AD&D CALCULATION                                                               
ADDPREM = ADDVOL / 1000 * .15 + .005                                            
*THE FOLLOWING ARE THE CALCULATIONS FOR THE QUARTERLY DEPENDENT RATE            
IF DEPLIFE = 'N'                                                                
DEPRATE = 0                                                                     
GO TO CALC                                                                      
END-IF                                                                          
                                                                                
*****CHANGE STARTS - HARSHA GANDHI - APRIL 8 2003                               
*****THE FOLLOWING PIECE OF CODE IS TO INCLUDE TWO NEW OPTIONS                  
*****FOR THE DEALER-OWNER PROGRAM.                                              
*****OPTION 1 IS NEW AND OPTION 2 IS THE SAME AS THE PREVIOUS ONE.              
IF DEPLIFE = '1'                                                                
   IF AGE LQ 29                                                                 
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 5.58          
      DEPRATE = 6.26                                                            
   END-IF                                                                       
   IF AGE = 30, 31, 32, 33, 34                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 6.18          
      DEPRATE = 6.93                                                            
   END-IF                                                                       
   IF AGE = 35, 36, 37, 38, 39                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 7.20          
      DEPRATE = 8.08                                                            
   END-IF                                                                       
   IF AGE = 40, 41, 42, 43, 44                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 9.18          
      DEPRATE = 10.30                                                           
   END-IF                                                                       
   IF AGE = 45, 46, 47, 48, 49                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 12.60         
      DEPRATE = 14.14                                                           
   END-IF                                                                       
   IF AGE = 50, 51, 52, 53, 54                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 18.18         
      DEPRATE = 20.40                                                           
   END-IF                                                                       
   IF AGE = 55, 56, 57, 58, 59                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 26.40         
      DEPRATE = 29.62                                                           
   END-IF                                                                       
   IF AGE = 60, 61, 62, 63, 64                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 37.08         
      DEPRATE = 41.60                                                           
   END-IF                                                                       
   IF AGE GQ 65                                                                 
      DEPRATE = 0.00                                                            
   END-IF                                                                       
END-IF                                                                          
*****THE OPTION 'Y' WAS CHANGED TO OPTION 2**************                       
IF DEPLIFE = '2'                                                                
   IF AGE LQ 29                                                                 
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 2.79          
      DEPRATE = 3.13                                                            
   END-IF                                                                       
   IF AGE = 30, 31, 32, 33, 34                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 3.09          
      DEPRATE = 3.47                                                            
   END-IF                                                                       
   IF AGE = 35, 36, 37, 38, 39                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 3.60          
      DEPRATE = 4.04                                                            
   END-IF                                                                       
   IF AGE = 40, 41, 42, 43, 44                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 4.59          
      DEPRATE = 5.15                                                            
   END-IF                                                                       
   IF AGE = 45, 46, 47, 48, 49                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 6.30          
      DEPRATE = 7.07                                                            
   END-IF                                                                       
   IF AGE = 50, 51, 52, 53, 54                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 9.09          
      DEPRATE = 10.20                                                           
   END-IF                                                                       
   IF AGE = 55, 56, 57, 58, 59                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 13.20         
      DEPRATE = 14.81                                                           
   END-IF                                                                       
   IF AGE = 60, 61, 62, 63, 64                                                  
*OLD RATES - NEW RATES EFFECTIVE 2007 LISTED BELOW      DEPRATE = 18.54         
      DEPRATE = 20.80                                                           
   END-IF                                                                       
   IF AGE GQ 65                                                                 
      DEPRATE = 0.00                                                            
   END-IF                                                                       
END-IF                                                                          
*****CHANGE ENDS   - HARSHA GANDHI - APRIL 8 2003                               
                                                                                
CALC                                                                            
TOTPREM = LPREM + ADDPREM + DEPRATE                                             
IF PROV = 06                                                                    
TAX = TOTPREM * .09                                                             
ELSE                                                                            
TAX = 0                                                                         
END-IF                                                                          
AMD = TAX + TOTPREM                                                             
PRINT                                                                           
**                                                                              
REPORT PAGESIZE 60 NOADJUST SKIP 1 TITLESKIP 2 +                                
                PRINTER FILEC                                                   
**                                                                              
SEQUENCE ZONE CERT                                                              
CONTROL FINAL NOPRINT ZONE NOPRINT NEWPAGE                                      
TITLE 1 '                                          CHRYSLER CANADA +            
LTD. DEALER-OWNER GROUP LIFE PLAN'                                              
TITLE 3 '                                                  ACTIVE +             
LISTING @ JAN 1, ' WS-Y2K-CURR-CCYY                                             
LINE COL 2 DEALNO COL 8 CERTIF COL 15 NAME COL 35 EFF COL 44 RED +              
COL 46 PERCENT COL 48 NODEAL COL 50 NOLIVE COL 52 LIFEVOL +                     
COL 59 LPREM COL 73 SMOKER COL 73 ADDVOL COL 82 ADDPREM +                       
COL 93 DEPRATE COL 100 TOTPREM COL 112 TAX COL 120 AMD                          
BEFORE-BREAK. PROC                                                              
IF LEVEL = 1                                                                    
DISPLAY SKIP 1 COL 50 LIFEVOL COL 73 ADDVOL +                                   
COL 93 DEPRATE COL 112 TAX                                                      
DISPLAY COL 59 LPREM +                                                          
COL 82 ADDPREM COL 100 TOTPREM +                                                
COL 120 AMD                                                                     
END-IF                                                                          
IF LEVEL = 2                                                                    
DISPLAY NEWPAGE '                                          CHRYSLER +           
CANADA LTD. DEALER-OWNER GROUP LIFE PLAN'                                       
DISPLAY SKIP 1 '                                                  +             
ACTIVE LISTING @ JAN 1, ' WS-Y2K-CURR-CCYY                                      
DISPLAY SKIP 2 COL 2 'DEAL.' COL 8 'CERT' COL 37 'EFF.' +                       
COL 54 'LIFE' COL 65 'LIFE' COL 77 'AD&D' COL 88 'AD&D' +                       
COL 97 'DEP.' COL 105 'TOTAL' COL 115 'SALES' COL 125 'AMOUNT'                  
DISPLAY COL 3 'NO.' COL 9 'NO.' COL 22 'NAME' COL 37 'DATE' +                   
COL 44 'A' COL 46 'B' COL 48 'C' COL 50 'D' COL 53 'VOLUME' +                   
COL 64 'PREM.' COL 73 'E' COL 76 'VOLUME' COL 87 'PREM.' +                      
COL 96 'PREM.' COL 105 'PREM.' COL 116 'TAX' COL 126 'DUE'                      
DISPLAY SKIP 1 'FINAL TOTALS' COL 50 LIFEVOL COL 73 ADDVOL +                    
COL 93 DEPRATE COL 112 TAX                                                      
DISPLAY COL 59 LPREM +                                                          
COL 82 ADDPREM COL 100 TOTPREM +                                                
COL 120 AMD                                                                     
END-IF                                                                          
END-PROC                                                                        
