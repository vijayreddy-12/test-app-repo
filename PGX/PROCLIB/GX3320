//GX3320  PROC CLVL='PROD',                                                     
//             CSTAT='PEN.GLHNEW',          ** CTLCARDS PREFIX                  
//             DLVL=PROD,                   ** DATA SET LEVEL                   
//             DSLVL=PROD,                  ** DATASERVER LEVEL                 
//             DSSTAT=PEN.GLHNEW,                                               
//             DSTAT=PGX,                   ** DATA SET STATUS                  
//             GEN0='(0)',                  ** GDG VERSION                      
//             GEN1='(+1)',                 ** GDG VERSION                      
//             GLVL=PROD,                   ** DATA SET LEVEL                   
//             GSTAT=PYN,                   ** DATA SET STATUS                  
//             OUTA='*',                    ** SYSOUT DEFN                      
//             OUTS='S',                    ** SYSUDUMP DEFN                    
//             SPACE1='(CYL,(10,5),RLSE)',  ** EXTRACT SPACE                    
//             SPACE2='(TRK,(1,1),RLSE)',   ** GENERATION SPACE                 
//             UNIT1=PROD,                  ** UNIT TYPE                        
//             UNIT2=SYSWK                  ** UNIT TYPE                        
//* -------------------------------------------------------------               
//* HISTORY :                                                                   
//* 29OCT2008 - IBM GR - ENTERPRISE COMPILER UPGRADE                            
//* JAN2012   - IDMSDB2 - GAEDATSR REPLACEMENT                                  
//*********************************************************************         
//*   CHECK TO SEE IF THE SOURCE FILE IS EMPTY.  IF THE FILE IS                 
//*   EMPTY, THE JOB WILL ABEND.                                                
//* -------------------------------------------------------------               
//*                                                                             
//GX332003 EXEC PGM=IDCAMS,                                                     
//             COND=(0,LT)                                                      
//IFILE     DD DSN=&GSTAT..DMS.&GLVL..GFM.MTHLY(0),                             
//             DISP=SHR                                                         
//SYSPRINT  DD SYSOUT=&OUTA                                                     
//SYSIN     DD DSN=&CSTAT..&CLVL..STANDARD.CTLCARDS(GX332003),                  
//             DISP=SHR                                                         
//* -------------------------------------------------------------               
//*   LIST THE INPUT GDG DATA FOR FILE:                                         
//*   PYN.DMS.PROD.GFM.MTHLY                                                    
//*   (RUNS A LISTCAT FUNCTION TO PRODUCE ALL DATASET INFORMATION               
//*    FOR A PARTICULAR GDG)                                                    
//* -------------------------------------------------------------               
//*                                                                             
//GX332005 EXEC PGM=IDCAMS,                                                     
//             COND=(0,LT)                                                      
//SYSPRINT  DD DSN=&&DMS,                                                       
//             DISP=(NEW,PASS,DELETE),                                          
//             UNIT=&UNIT2,                                                     
//             SPACE=&SPACE2,                                                   
//             DCB=(RECFM=VBA,LRECL=134,BLKSIZE=27872)                          
//SYSIN     DD DSN=&CSTAT..&CLVL..STANDARD.CTLCARDS(GX332005),                  
//             DISP=SHR                                                         
//* -------------------------------------------------------------               
//*   REMOVE ALL BUT THE GDG NAMES                                              
//*   (SORT OUT ALL DATASET INFORMATION AND LEAVE ONLY THE NAMES                
//*    OF ALL GDG VERSIONS IN THE RESULTING DATASET)                            
//* -------------------------------------------------------------               
//*                                                                             
//GX332010 EXEC PGM=SORT,                                                       
//             COND=(0,LT)                                                      
//SORTIN    DD DSN=&&DMS,                                                       
//             DISP=(OLD,DELETE)                                                
//SORTOUT   DD DSN=&&GDG,                                                       
//             DISP=(NEW,PASS,DELETE),                                          
//             UNIT=&UNIT2,                                                     
//             SPACE=&SPACE2,                                                   
//             DCB=(RECFM=VB,LRECL=134,BLKSIZE=27872)                           
//SYSIN     DD DSN=&CSTAT..&CLVL..STANDARD.CTLCARDS(GX332010),                  
//             DISP=SHR                                                         
//SYSOUT    DD SYSOUT=*                                                         
//* -------------------------------------------------------------               
//*   EXTRACT THE MOST RECENT FILE NAME                                         
//*   (REMOVE ALL DATASET NAMES FROM THE GDG DATASET NAME LIST                  
//*    EXCEPT FOR THE MOST CURRENT)                                             
//* -------------------------------------------------------------               
//*                                                                             
//GX332015 EXEC PGM=SORT,                                                       
//             COND=(0,LT)                                                      
//SORTIN    DD DSN=&&GDG,                                                       
//             DISP=(OLD,DELETE)                                                
//SORTOUT   DD DSN=&&GDGNAME,                                                   
//             DISP=(NEW,PASS,DELETE),                                          
//             UNIT=&UNIT2,                                                     
//             SPACE=&SPACE2,                                                   
//             DCB=(RECFM=VB,LRECL=134,BLKSIZE=27872)                           
//SYSIN     DD DSN=&CSTAT..&CLVL..STANDARD.CTLCARDS(GXRCTNAM),                  
//             DISP=SHR                                                         
//SYSOUT    DD SYSOUT=*                                                         
//* -------------------------------------------------------------               
//*   EXTRACT THE GENERATION NUMBER FROM THE GDG NAME                           
//*   (EG. G0002V00)                                                            
//* -------------------------------------------------------------               
//*                                                                             
//GX332020 EXEC PGM=SORT,                                                       
//             COND=(0,LT)                                                      
//SORTIN    DD DSN=&&GDGNAME,                                                   
//             DISP=(OLD,DELETE)                                                
//SORTOUT   DD DSN=&DSTAT..CMRP.&DLVL..DMSGFM.CURR.GEN&GEN1,                    
//             DISP=(NEW,CATLG,DELETE),                                         
//             UNIT=&UNIT1,                                                     
//             SPACE=&SPACE2,                                                   
//             DCB=(SYS1.GDG.MODEL.SEQ,RECFM=VB,LRECL=134,                      
//             BLKSIZE=27872)                                                   
//SYSIN     DD DSN=&CSTAT..&CLVL..STANDARD.CTLCARDS(GX332020),                  
//             DISP=SHR                                                         
//SYSOUT    DD SYSOUT=*                                                         
//* -------------------------------------------------------------               
//*   INSERT TRAILER AND CONTROL DATA ON DMS GFM EXTRACT                        
//* -------------------------------------------------------------               
//*                                                                             
//GX332025 EXEC PGM=CMRPTRLR,                                                   
//             COND=(0,LT)                                                      
//*------------------------------------------------------------------*          
//* DATA SERVER FILES                                                *          
//*------------------------------------------------------------------*          
//DLSI00    DD DSN=&DSSTAT..&DSLVL..STANDARD.TABLE(GAEDATSR),                   
//             DISP=SHR                                                         
//*------------------------------------------------------------------*          
//DLSI10    DD DSN=&GSTAT..DMS.&GLVL..GFM.MTHLY(0),                             
//             DISP=SHR                                                         
//DLSI71    DD DSN=&DSTAT..CMRP.&DLVL..DMSGFM.CURR.GEN&GEN1,                    
//             DISP=SHR                                                         
//DLSI72    DD DSN=&DSTAT..CMRP.&DLVL..DMSGFM.EXPECT.GEN&GEN0,                  
//             DISP=SHR                                                         
//DLSI13    DD DSN=&CSTAT..&CLVL..STANDARD.CTLCARDS(GX332025),                  
//             DISP=SHR                                                         
//DLSO20    DD DSN=&DSTAT..CMRP.&DLVL..EXTR.DMSGFM.FEED&GEN1,                   
//             DISP=(NEW,CATLG,DELETE),                                         
//             UNIT=&UNIT1,                                                     
//             SPACE=&SPACE1,                                                   
//             DCB=(SYS1.GDG.MODEL.SEQ,RECFM=FB,LRECL=80,BLKSIZE=27920)         
//DLSO70    DD DSN=&DSTAT..CMRP.&DLVL..DMSGFM.EXPECT.GEN&GEN1,                  
//             DISP=(NEW,CATLG,DELETE),                                         
//             UNIT=&UNIT1,                                                     
//             SPACE=&SPACE2,                                                   
//             DCB=(SYS1.GDG.MODEL.SEQ,RECFM=VB,LRECL=134,                      
//             BLKSIZE=27872)                                                   
//SYSPRINT  DD SYSOUT=&OUTA                                                     
//ABENDAID  DD SYSOUT=&OUTS                                                     
//SYSUDUMP  DD SYSOUT=&OUTS                                                     
//SYSABOUT  DD SYSOUT=&OUTS                                                     
//SYSOUT    DD SYSOUT=&OUTA                                                     
//SYSTSPRT  DD SYSOUT=&OUTA                                                     
