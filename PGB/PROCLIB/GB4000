//GB4000  PROC CLVL='PROD.STANDARD',                                            
//             CSTAT='PEN.GROUP',           ** CTLCARD  STATUS                  
//             DLVL=PROD,                   ** DATA SET LEVEL                   
//             DSLVL=PROD,                  ** DATASERVER LEVEL                 
//             DSSTAT=PEN.GLHNEW,           ** DATASERVER PREFIX                
//             DSTAT=PYT,                   ** DATA SET STATUS                  
//             GEN0='(0)',                  ** CURRENT GDG VOLUME               
//             GEN1='(+1)',                 ** NEXT    GDG VOLUME               
//             OUTA='*',                    ** SYSOUT DEFN                      
//             OUTLVL=PROD,                 ** DATA SET STATUS                  
//             OUTS='S',                    ** SYSUDUMP DEFN                    
//             OUTSTAT=PGB,                 ** DATA SET STATUS                  
//             RUNTYPE=PYTHSCA1,            ** RUN TYPE                         
//             SPACE1='(CYL,(200,20),RLSE)', * OUTPUT FILE SIZE                 
//             TSOLVL='PROD.STANDARD',      ** TSO DATASET                      
//             TSOSTAT='PEN.GROUP',         ** TSO DATASET LEVEL                
//             UNIT=PROD                    ** SYSTEM UNIT                      
//*********************************************************************         
