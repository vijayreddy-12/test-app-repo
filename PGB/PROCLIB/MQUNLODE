//SYSLST    DD SYSOUT=&SYSOUT                                                   
//ABENDAID  DD SYSOUT=&DMPOUT                                                   
//SYSUDUMP  DD SYSOUT=&DMPOUT                                                   
//SYSABOUT  DD SYSOUT=&SYSOUT                                                   
//SYSOUT    DD SYSOUT=&SYSOUT                                                   
