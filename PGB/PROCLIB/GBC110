//SORTWK01 DD   UNIT=SYSWK,SPACE=(CYL,2,RLSE)                                   
//SORTWK02 DD   UNIT=SYSWK,SPACE=(CYL,2,RLSE)                                   
//SORTWK03 DD   UNIT=SYSWK,SPACE=(CYL,2,RLSE)                                   
//SORTJNF1 DD   DISP=SHR,                                                       
//         DSN=&DSTAT..CPD.&DLVL..GBC110.ZCUST.DIFF                             
//SORTJNF2 DD   DISP=SHR,                                                       
//         DSN=&DSTAT..CPD.&DLVL..GBC110.ZGCT.MRG                               
//SORTOUT  DD   DSN=&DSTAT..CPD.&DLVL..GBC110.CLIEXSTG&GEN2.,                   
//         DISP=(NEW,CATLG,DELETE),                                             
//         UNIT=&UNIT01.,                                                       
//         DCB=(*.SORTJNF1),                                                    
